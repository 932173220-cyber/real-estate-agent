OPENAI_API_KEY=
# 兼容端点：智谱 / DeepSeek / OpenAI；本地 Ollama、vLLM 用 http://127.0.0.1:<端口>/v1
# 其他自定义地址需显式设置 ALLOW_CUSTOM_BASE_URL=1
OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
# 填写你的账户可用的模型名称；对话需要有效模型配置。
PROPERTY_MODEL=
PROPERTY_BROKER_ID=local-broker

# 检索：BGE 向量 + Chroma + BM25/RRF
# 指向本地 BGE 目录；留空时优先使用 models/bge-small-zh-v1.5，
# 目录不存在则尝试下载 BAAI/bge-small-zh-v1.5；加载失败会降低检索质量。
EMBEDDING_MODEL=
EMBEDDING_BACKEND=bge
DENSE_TOP_K=10
LEXICAL_TOP_K=10
RRF_K=60
RETRIEVAL_TOP_K=3

# 会话/画像/摘要缓存（不可用时自动降级为进程内缓存）
REDIS_URL=redis://127.0.0.1:6379/0
CACHE_TTL=3600
HISTORY_TURNS=8
